# Example environment variables for MCP servers
# Copy this file to .env and fill in your actual values
#
# Note: If using Claude Code, you can also set these in .claude/settings.local.json:
# { "env": { "GEMINI_API_KEY": "your-key-here" } }

# Gemini Alt Tag Generator
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Override default Gemini model for alt tag generation
# Available models (as of 2025):
#   gemini-flash-latest        (default - best price/performance)
#   gemini-2.5-flash          (well-rounded, large context)
#   gemini-2.5-pro            (flagship reasoning model, 1M+ token context)
#   gemini-2.5-flash-lite     (ultra-fast, lightweight, cost-optimized)
#   gemini-2.0-flash          (1M token context, native tool use)
#   gemini-2.0-flash-lite     (cost efficient, low latency)
#   gemini-2.0-flash-thinking-experimental (shows reasoning process)
#   gemini-pro                (legacy model)
# GEMINI_MODEL=gemini-flash-latest

# Google Ads Planner
# Requires a Basic-access-tier developer token (Test and Explorer tiers cannot
# call the keyword planning endpoints). Apply from the API Center of your
# manager (MCC) account: https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token-here

# Base64 of the GCP service account JSON key (no impersonation is used — add the
# service account email as a user in the Ads account under Admin > Access and
# security). Generate with: base64 -i service-account.json | tr -d '\n'
GOOGLE_ADS_SERVICE_ACCOUNT_KEY_B64=your-base64-encoded-service-account-json-here

# Manager (MCC) account id, digits only — sent as the login-customer-id header
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# Client account actually queried, digits only — goes into the request URL
GOOGLE_ADS_CUSTOMER_ID=9876543210

# Optional: override the Google Ads API version (v19-v21 are sunset)
# GOOGLE_ADS_API_VERSION=v25

# Prefer 1Password over plain values above. .mcp.json launches this server through
# `op run`, so it carries op:// references rather than secrets; the same works here --
# swap each value for a reference and run under `op run --no-masking`, e.g.
#   GOOGLE_ADS_DEVELOPER_TOKEN=op://Startupkit/Google Ads MCP/credential
# See README "Google Ads Planner setup". Item titles must not contain parentheses.

# Add other API keys and credentials as needed
# API_KEY=your_api_key_here
# DATABASE_URL=your_database_url_here
