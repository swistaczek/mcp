{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {}
    },
    "Context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "env": {}
    },
    "Domain Checker": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "uv run --with fastmcp fastmcp run domains.fastmcp.json"],
      "env": {}
    },
    "Image Descriptions": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "uv run --with fastmcp fastmcp run gemini_image_descriptions.fastmcp.json"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    },
    "Tablica Rejestracyjna PL": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "uv run --with fastmcp fastmcp run tablica.fastmcp.json"],
      "env": {}
    },
    "EXIF Extractor": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "uv run --with fastmcp fastmcp run exif_extractor.fastmcp.json"
      ],
      "env": {}
    },
    "Plate Recognition": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "uv run --with fastmcp fastmcp run plate_recognition.fastmcp.json"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    },
    "Czy Na Czas": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "uv run --with fastmcp fastmcp run czynaczas.fastmcp.json"],
      "env": {}
    },
    "Gazetki": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "uv run --with fastmcp fastmcp run gazetki.fastmcp.json"],
      "env": {}
    },
    "KRS Poland": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "uv run --with fastmcp fastmcp run krs.fastmcp.json"],
      "env": {}
    },
    "Poznan Events": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "uv run --with fastmcp fastmcp run poznan_events.fastmcp.json"],
      "env": {}
    },
    "Label Printer": {
      "type": "stdio",
      "command": "sh",
      "args": ["-c", "uv run --with fastmcp fastmcp run label_printer.fastmcp.json"],
      "env": {}
    },
    "Google Ads Planner": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "op run --no-masking -- uv run --with fastmcp fastmcp run google_ads_planner.fastmcp.json"
      ],
      "env": {
        "GOOGLE_ADS_DEVELOPER_TOKEN": "op://Startupkit/Google Ads MCP/credential",
        "GOOGLE_ADS_SERVICE_ACCOUNT_KEY_B64": "op://Startupkit/Google Ads MCP/Service Account/SERVICE_ACCOUNT_KEY_B64",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "op://Startupkit/Google Ads MCP/ads_manager_account_id",
        "GOOGLE_ADS_CUSTOMER_ID": "op://Startupkit/Google Ads MCP/company_account_id"
      }
    }
  }
}
